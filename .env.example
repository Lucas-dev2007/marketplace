# Variáveis de ambiente do Marketplace
#
# IMPORTANTE: o projeto não lê este arquivo sozinho. Ele serve de referência:
# copie os valores e exporte no terminal, configure na sua IDE (Run > Edit
# Configurations > Environment variables) ou use no seu servidor.
#
# Os valores abaixo são fictícios. Troque as senhas antes de qualquer uso real.

# --- Usuários da API (HTTP Basic) -----------------------------------------
# Sem estas variáveis a aplicação usa a senha de desenvolvimento (igual ao
# nome do usuário) e avisa no log.
MARKET_API_USER=admin
MARKET_API_PASSWORD=defina-uma-senha-forte
MARKET_CLIENTE_USER=cliente
MARKET_CLIENTE_PASSWORD=defina-outra-senha-forte

# --- Banco de registro: clientes, endereços e pedidos (porta 3307) --------
REGISTRATION_DB_URL=jdbc:mysql://localhost:3307/registration
REGISTRATION_DB_USERNAME=app
REGISTRATION_DB_PASSWORD=defina-uma-senha-do-banco

# --- Banco de catálogo: produtos (porta 3308) -----------------------------
CATALOG_DB_URL=jdbc:mysql://localhost:3308/catalog
CATALOG_DB_USERNAME=app
CATALOG_DB_PASSWORD=defina-outra-senha-do-banco

# --- Comportamento --------------------------------------------------------
# Cria 20 produtos e 20 clientes de demonstração quando as tabelas estão vazias.
MARKET_SEED_ENABLED=true

# O esquema é criado pelo Flyway. O Hibernate só valida ("validate").
REGISTRATION_DB_DDL=validate
CATALOG_DB_DDL=validate
